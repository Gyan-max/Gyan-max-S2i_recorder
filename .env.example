# Copy to .env and adjust. Loaded automatically by api/app/config.py.
# Real environment variables always win over values in this file.

# ──────────────── Application Environment ────────────────
# "development" fills in safe local defaults and only warns.
# "production"  refuses to start with a missing/weak JWT key or a default
#               admin password.
APP_ENV=development

# ──────────────── Security & Authentication ────────────────
# Generate with: openssl rand -hex 32
# Leave blank in development and an ephemeral key is generated per process.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ADMIN_USERNAME=admin
# Leave blank in development to use 'admin123'. Required in production.
ADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_HOURS=8

# Admin login brute-force protection
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=300

# ──────────────── Database ────────────────
# Leave blank to use <project-root>/data/s2i_recorder.db as an absolute path.
# Note the four slashes for an absolute SQLite path:
#   sqlite+aiosqlite:////absolute/path/to/s2i_recorder.db
# For production PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/s2i_recorder
DATABASE_URL=

# ──────────────── Persistent Storage ────────────────
# Leave blank to use <project-root>/storage. Relative values are resolved
# against the project root, never the current working directory.
STORAGE_BASE_PATH=
MAX_UPLOAD_SIZE_MB=25

# ──────────────── CORS Allowed Origins ────────────────
# Comma-separated. Must list explicit origins in production - credentials are
# allowed, so a wildcard would let any site drive the API as a logged-in admin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ──────────────── Audio Quality Control ────────────────
QC_MIN_DURATION_S=0.8
QC_MAX_DURATION_S=15.0
QC_MIN_SNR_DB=12.0

# ──────────────── Audio Processing ────────────────
FFMPEG_PATH=ffmpeg
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1
# 'mock' returns a fixed placeholder transcript for every clip.
ASR_PROVIDER=mock

# ──────────────── Server ────────────────
LOG_LEVEL=INFO
