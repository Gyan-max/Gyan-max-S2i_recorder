# Copy to functions/.env — Firebase deploys this file's values as runtime
# environment variables for the functions. It contains no secrets (the Admin
# SDK authenticates via the runtime service account), but .env is gitignored
# so per-project values do not get committed.

# Required. Newer Firebase projects use "<project>.firebasestorage.app";
# older ones use "<project>.appspot.com". Copy the exact value from
# console → Storage, or from the web app config's storageBucket.
STORAGE_BUCKET=s2i-hinglish.firebasestorage.app

# Exact frontend origins allowed to call the API, comma-separated.
# Not needed when the frontend is served by Firebase Hosting, since
# firebase.json rewrites /api/** to the function and the browser stays
# same-origin. Required if you host the frontend elsewhere (e.g. Vercel).
# CORS_ORIGINS=https://s2i-hinglish.web.app

# Optional overrides — defaults in s2i/config.py are usually right.
# MAX_UPLOAD_SIZE_MB=25
# QC_MIN_DURATION_S=0.8
# QC_MAX_DURATION_S=15.0
# QC_MIN_SNR_DB=12.0
# COVERAGE_FLOOR=40
# CONSENT_VERSION=consent-v1
